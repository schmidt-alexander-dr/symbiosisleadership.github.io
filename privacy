  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:      #2D6A4F;
      --green-lt:   #EBF5EE;
      --black:      #111111;
      --grey:       #555555;
      --grey-lt:    #888888;
      --rule:       #DDDDDD;
      --bg:         #FAFAF8;
      --white:      #FFFFFF;
      --serif:      'DM Serif Display', Georgia, serif;
      --sans:       'Inter', -apple-system, sans-serif;
      --max:        740px;
      --pad:        clamp(1.5rem, 5vw, 3rem);
    }

    body {
      font-family: var(--sans);
      font-size: 17px;
      line-height: 1.65;
      color: var(--black);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }

    /* ── Nav (matches retreat page) ───────────────────────────────────── */
    nav {
      border-bottom: 1px solid var(--rule);
      padding: 1.1rem var(--pad);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--white);
    }
    .nav-brand {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--grey);
      text-decoration: none;
      text-transform: uppercase;
    }
    .nav-brand span { color: var(--green); }
    .nav-links a {
      font-size: 13px;
      color: var(--grey);
      text-decoration: none;
      font-weight: 500;
    }
    .nav-links a:hover { color: var(--green); }

    /* ── Page ─────────────────────────────────────────────────────────── */
    .page {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(2.5rem, 7vw, 4.5rem) var(--pad) clamp(3rem, 8vw, 5rem);
    }
    .eyebrow {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 1rem;
    }
    h1 {
      font-family: var(--serif);
      font-size: clamp(2.1rem, 5vw, 3rem);
      line-height: 1.15;
      margin-bottom: 1rem;
    }
    .updated {
      font-size: 13px;
      color: var(--grey-lt);
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule);
    }
    h2 {
      font-family: var(--serif);
      font-size: clamp(1.25rem, 3vw, 1.55rem);
      line-height: 1.25;
      margin-top: 2.4rem;
      margin-bottom: 0.9rem;
    }
    p { color: var(--grey); margin-bottom: 1rem; }
    p:last-child { margin-bottom: 0; }
    a { color: var(--green); }
    strong { color: var(--black); font-weight: 600; }

    ul { margin: 0 0 1rem 0; padding-left: 1.1rem; color: var(--grey); }
    li { margin-bottom: 0.45rem; }
    li:last-child { margin-bottom: 0; }

    .callout {
      background: var(--green-lt);
      border-left: 3px solid var(--green);
      border-radius: 0 4px 4px 0;
      padding: 1.2rem 1.4rem;
      margin: 1.5rem 0;
    }
    .callout p { margin-bottom: 0.6rem; }
    .callout p:last-child { margin-bottom: 0; }

    /* ── Footer (matches retreat page) ────────────────────────────────── */
    footer {
      border-top: 1px solid var(--rule);
      padding: 2rem var(--pad);
      text-align: center;
      font-size: 13px;
      color: var(--grey-lt);
      line-height: 1.7;
    }
    footer a { color: var(--green); text-decoration: none; }
    footer a:hover { text-decoration: underline; }
    footer p + p { margin-top: 0.6rem; }
  </style>
